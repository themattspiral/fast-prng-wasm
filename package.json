{
  "name": "fast-prng-wasm",
  "version": "0.0.0-semantically-released",
  "description": "High-performance, SIMD-enabled WebAssembly PRNGs with a seamless TypeScript interface. Includes PCG, xoroshiro128+, and xoshiro256+",
  "author": "Matt Ritter <matthew.d.ritter@gmail.com>",
  "license": "MIT",
  "keywords": [
    "prng",
    "random",
    "pseudo",
    "number",
    "generator",
    "wasm",
    "webassembly",
    "assemblyscript",
    "pcg",
    "pcg-random",
    "xoroshiro128",
    "xoroshiro128+",
    "xoshiro256",
    "xoshiro256+",
    "simd",
    "wasm-simd",
    "monte-carlo"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.mjs",
  "unpkg": "./dist/index.umd.js",
  "jsdelivr": "./dist/index.umd.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./assembly": {
      "import": "./assembly/index.ts",
      "default": "./assembly/index.ts"
    }
  },
  "files": [
    "dist",
    "assembly",
    "!assembly/test",
    "!assembly/typedoc.json"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.0-beta.7",
    "assemblyscript": "0.28.20",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "rolldown-plugin-wasm": "^0.3.2",
    "tsdown": "^0.22.14",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.12.0",
    "typescript": "^6.0.3",
    "vitest": "5.0.0-beta.7",
    "vitest-pool-assemblyscript": "^0.17.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/themattspiral/fast-prng-wasm.git"
  },
  "scripts": {
    " // Build: Compiles WASM & Bundles Lib ------------": "",
    "clean": "node util/clean.mjs",
    "build": "npm run clean && npm run wasm && npm run lib",
    " // Lib: Transpiles TS and bundles modules into dist ------------": "",
    "lib": "tsdown",
    " // Docs: Generates API docs as Markdown ------------": "",
    "docs": "npm run docs:js && npm run docs:as",
    "docs:js": "typedoc --options typedoc.json",
    "docs:as": "typedoc --options assembly/typedoc.json --tsconfig assembly/tsconfig.json",
    " // Test: Runs unit tests ------------": "",
    "test": "(node util/check-build.mjs || npm run build) && vitest run",
    "test:watch": "(node util/check-build.mjs || npm run build) && vitest watch",
    "test:c-ref": "cd assembly/test/c-reference && bash build-and-run.sh",
    " // WASM Release: Compiles AssemblyScript to WASM binaries ------------": "",
    "wasm": "npm run wasm:pcg && npm run wasm:xoroshiro128plus && npm run wasm:xoroshiro128plus-simd && npm run wasm:xoshiro256plus && npm run wasm:xoshiro256plus-simd",
    "wasm:pcg": "asc assembly/prng/pcg.ts --target pcg --config asconfig.release.json",
    "wasm:xoroshiro128plus": "asc assembly/prng/xoroshiro128plus.ts --target xoroshiro128plus --config asconfig.release.json",
    "wasm:xoroshiro128plus-simd": "asc assembly/prng/xoroshiro128plus-simd.ts --target xoroshiro128plus-simd --config asconfig.release.json",
    "wasm:xoshiro256plus": "asc assembly/prng/xoshiro256plus.ts --target xoshiro256plus --config asconfig.release.json",
    "wasm:xoshiro256plus-simd": "asc assembly/prng/xoshiro256plus-simd.ts --target xoshiro256plus-simd --config asconfig.release.json",
    " // WASM Debug: Compiles AssemblyScript to WASM Binaries & Debug Text ------------": "",
    "wasm:debug": "npm run wasm:pcg:debug && npm run wasm:xoroshiro128plus:debug && npm run wasm:xoroshiro128plus-simd:debug && npm run wasm:xoshiro256plus:debug && npm run wasm:xoshiro256plus-simd:debug",
    "wasm:pcg:debug": "asc assembly/prng/pcg.ts --target pcg --config asconfig.debug.json",
    "wasm:xoroshiro128plus:debug": "asc assembly/prng/xoroshiro128plus.ts --target xoroshiro128plus --config asconfig.debug.json",
    "wasm:xoroshiro128plus-simd:debug": "asc assembly/prng/xoroshiro128plus-simd.ts --target xoroshiro128plus-simd --config asconfig.debug.json",
    "wasm:xoshiro256plus:debug": "asc assembly/prng/xoshiro256plus.ts --target xoshiro256plus --config asconfig.debug.json",
    "wasm:xoshiro256plus-simd:debug": "asc assembly/prng/xoshiro256plus-simd.ts --target xoshiro256plus-simd --config asconfig.debug.json"
  }
}
